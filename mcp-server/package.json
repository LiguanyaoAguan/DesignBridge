{
  "name": "designbridge-mcp-server",
  "version": "0.2.0",
  "private": true,
  "description": "DesignBridge 本地 MCP Server：读取设计契约与任务、提交执行结果",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
