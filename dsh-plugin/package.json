{
  "name": "designbridge-studio-plugin",
  "version": "0.3.0",
  "private": true,
  "description": "DesignBridge Studio：DeepSeek Harness 右侧栏只读设计面板与 Preview Schema 校验（v0.3b-b3）",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-workspace-files",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
